# MedGuardian Environment Variables Example

# Neon PostgreSQL Database Connection URL (Replace with your actual database URL in .env)
DATABASE_URL=postgresql://username:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require

# Frontend API Base URL (Optional - defaults to relative /api when deployed on Vercel)
# VITE_API_BASE_URL=https://your-app-name.vercel.app
